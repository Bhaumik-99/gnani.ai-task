# Gnani API key for Prisma v3.0 and Timbre v3.0
GNANI_API_KEY=
PRISMA_MODEL=prisma-v3.0
PRISMA_WS_URL=wss://api.vachana.ai/stt/v3/stream
PRISMA_LANGUAGE_CODE=indic-auto
PRISMA_FORMAT=codemix
PRISMA_SAMPLE_RATE=16000
PRISMA_IDLE_TIMEOUT_SECONDS=180

TIMBRE_MODEL=timbre-v3.0
TIMBRE_WS_URL=wss://api.vachana.ai/api/v1/tts
TIMBRE_VOICE=Shivani
TIMBRE_LANGUAGE=hi-en
TIMBRE_SAMPLE_RATE=24000

# Evon v3.3 open weights served through an OpenAI-compatible vLLM endpoint.
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=model
EVON_TIMEOUT_SECONDS=20

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
SESSION_SIGNING_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_TTL_SECONDS=840
MAX_AUDIO_FRAME_BYTES=1024
MAX_TRANSCRIPT_CHARS=4000
MAX_TTS_AUDIO_BYTES=12000000
MAX_SESSIONS_PER_MINUTE=10
REDIS_URL=
